{
  "name": "portmux",
  "version": "0.1.0",
  "private": true,
  "description": "Browse live remote dev ports and forward them locally from an OpenTUI interface",
  "type": "module",
  "bin": {
    "portmux": "./apps/portmux/dist/portmux.js"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "turbo run clean",
    "dev": "pnpm --filter @portmux/app dev",
    "fallow": "fallow",
    "fallow:audit": "fallow audit --gate new-only",
    "format": "biome check --write .",
    "gitleaks": "gitleaks dir --redact --verbose .",
    "lint": "biome check .",
    "portmux": "pnpm --filter @portmux/app start",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "1.3.14",
    "fallow": "3.5.1",
    "lefthook": "2.1.10",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
